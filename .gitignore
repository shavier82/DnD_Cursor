# D&D Campaign Management - .gitignore

# =============================================================================
# SECRETS - NEVER COMMIT THESE
# =============================================================================
OpenAI_Key.txt
google_credentials.json
*.key
*.pem
*.pfx
*.p12
.env
.env.local
.env.*.local
secrets/
credentials/
*.secret
*.private

# =============================================================================
# CURSOR / WORKTREE PROTECTION
# =============================================================================
# Parallel agent temp outputs
.coord-*/
.cursor-worktrees/
.agent-id
.session-id
.cursor/
.cursor-session/

# Worktree directories (if any are created)
worktrees/
*.worktree

# =============================================================================
# CAMPAIGN DATA PROTECTION
# =============================================================================
# Ensure campaign data is NEVER tracked
Campaigns/
../Campaigns/
../../Campaigns/
C:/DnD/Campaigns/
**/Campaigns/Phandelver/

# =============================================================================
# SOURCEBOOKS / PDFS
# =============================================================================
# Never track sourcebooks anywhere
Sourcebooks/
**/Sourcebooks/
*.pdf

# =============================================================================
# OS FILES
# =============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# =============================================================================
# EDITOR FILES
# =============================================================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Cursor (additional)
.cursor/
.cursorrules.local

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# =============================================================================
# PYTHON
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv
.ENV
.env

# PyCharm
.idea/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# pyenv
.python-version

# pipenv
Pipfile.lock

# Poetry
poetry.lock

# =============================================================================
# NODE.JS (if using)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# =============================================================================
# TEMPORARY FILES
# =============================================================================
*.tmp
*.temp
*.log
*.bak
*.backup
*.swp
*.swo
*~
.cache/

# =============================================================================
# BACKUP FILES
# =============================================================================
backups/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# =============================================================================
# ONE DRIVE PROTECTION
# =============================================================================
# Explicitly ignore OneDrive sync files
OneDrive/
OneDrive - */
*.odt




