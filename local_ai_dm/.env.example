# Local AI Dungeon Master configuration
# Copy to .env and adjust as needed.

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
# Lower context window saves VRAM on 12GB GPUs (default 4096)
OLLAMA_NUM_CTX=4096
# Optional: cap GPU layers if a larger model OOMs (e.g. OLLAMA_NUM_GPU=20 for qwen3:8b)
# OLLAMA_NUM_GPU=

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
DM_DEBUG_PANEL=true

# Paths (relative to local_ai_dm/ unless absolute)
DATABASE_URL=sqlite:///./data/campaigns/ai_dm.db
SOURCEBOOKS_DIR=C:/DnD/Sourcebooks
CHROMA_DIR=./data/chroma
RAG_ENABLED=true
RAG_TOP_K=4
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO
# Never log DM secrets or full sourcebook chunks by default
LOG_DM_SECRETS=false
LOG_RAG_CHUNK_TEXT=false
